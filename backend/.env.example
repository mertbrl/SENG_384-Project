NODE_ENV=development
PORT=5000
# Default docker-compose.yml maps Postgres to host port 5433 (see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/healthai_dev"
JWT_SECRET=change_this_to_a_random_256_bit_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="ClinBridge Platform <noreply@example.com>"
